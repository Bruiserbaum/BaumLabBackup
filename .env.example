SECRET_KEY=           # openssl rand -hex 32
ADMIN_PASSWORD=       # admin password set on first start
ADMIN_RESET=false     # set to true to force-reset admin password to ADMIN_PASSWORD on next start (then set back to false)
WEB_PORT=8765
TZ=America/New_York

# ── Authentik SSO (optional) ───────────────────────────────────────────────────
# Forward auth — header-based auto-login via Nginx Proxy Manager + Authentik.
# When NPM's forward auth is active, Authentik injects X-authentik-username into
# every request. Setting this to true lets BaumLabBackup issue a local JWT
# automatically so the user never sees a login page.
# Requires the npm-forward-auth.conf snippet applied in NPM — see BaumDocker/authentik/README.
#
# AUTHENTIK_HEADER_AUTH=true

# OIDC login via Authentik. When enabled, a "Login with Authentik" button
# appears on the login page alongside the existing username/password form.
#
# In Authentik: create an OAuth2/OpenID Provider + Application.
# Redirect URI to register in Authentik:
#   http://your-server:8765/api/auth/oidc/callback
#   (or https://backup.yourdomain.com/api/auth/oidc/callback if behind a reverse proxy)
#
# OIDC_ENABLED=true
# OIDC_ISSUER=https://auth.yourdomain.com/application/o/<app-slug>/
# OIDC_CLIENT_ID=REPLACE_WITH_CLIENT_ID
# OIDC_CLIENT_SECRET=REPLACE_WITH_CLIENT_SECRET
# OIDC_REDIRECT_URI=http://your-server:8765/api/auth/oidc/callback
